# Database configuration (SQLite for local dev, PostgreSQL for production/docker)
# Cloud providers (Render, Railway, Supabase) provide postgres:// or postgresql:// URLs;
# the backend automatically normalizes them to postgresql+psycopg://.
DATABASE_URL=sqlite:///./landshield.db

# Server port (Render/Railway sets PORT dynamically; defaults to 8000)
PORT=8000

# Authentication (Change in production)
JWT_SECRET=replace-with-a-secure-random-secret-in-production
JWT_EXPIRE_MINUTES=60

# Cryptographic signing key (PyNaCl Ed25519)
# In local/docker dev, loaded from file. In cloud hosting (Render/Railway), provide
# SIGNING_KEY_HEX as an environment variable to avoid ephemeral volume loss.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_KEY_PATH=./keys/registrar_ed25519.hex
SIGNING_KEY_HEX=

# Demo mode & security
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Rate limits & business thresholds
RATE_LIMIT=60/minute
MUTATION_DAYS=90
# Automatically seed DB on startup if empty (essential on first cloud boot)
SEED_ON_START=true

# Phase 2 Feature Flags (runtime toggleable)
FEATURE_RECONCILE=true
FEATURE_LINEAGE=true
FEATURE_OFFLINE_QR=true
FEATURE_AGENT=true
FEATURE_TRANSPARENCY=true
FEATURE_ML=false
FEATURE_OCR=false

# LLM Runtime Configuration (Optional - template fallback if absent)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
AGENT_TIMEOUT_SECONDS=20
